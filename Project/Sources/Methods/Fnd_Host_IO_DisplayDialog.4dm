//%attributes = {"invisible":false,"shared":true,"folder":"Fnd_Project_Methods","lang":"en"}
// ----------------------------------------------------
// Project Method: Fnd_Host_IO_DisplayDialog ($formName_t {; $formData_o {; $continueExecution_b}})

// Allows a component to open a dialog in the host's variable space when compiled.

// Access: Shared

// Parameters: 
//   $formName_t : Text : Project form name
//   $formData_o : Object : Data passed to the form (optional)
//   $continueExecution_b : Boolean : True to use the * (non-blocking) form of DIALOG (optional)

// Returns: Nothing

// This method was automatically generated by Foundation on Oct 18, 2026.
// ----------------------------------------------------

#DECLARE($formName_t : Text; $formData_o : Object; $continueExecution_b : Boolean)

var $parameterCount_i : Integer

$parameterCount_i:=Count parameters

Case of 
	: ($parameterCount_i=1)
		DIALOG($formName_t)
		
	: ($parameterCount_i=2)
		DIALOG($formName_t; $formData_o)
		
	Else 
		If ($continueExecution_b)
			DIALOG($formName_t; $formData_o; *)
		Else 
			DIALOG($formName_t; $formData_o)
		End if 
End case 

