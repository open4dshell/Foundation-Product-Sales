// ----------------------------------------------------
// Project Method: Fnd_Host_GetFormProperties ($table_ptr; $formName_t; $width_ptr; $height_ptr)

// Allows a component to get the width and height of a host form.

// Access: Shared

// Parameters: 
//   $table_ptr : Pointer : Table pointer or nil
//   $formName_t : Text : Form name
//   $width_ptr : Pointer : Longint to get width
//   $height_ptr : Pointer : Longint to get height

// Returns: Nothing

// This method was automatically generated by Foundation on Oct 18, 2026.
// ----------------------------------------------------

#DECLARE($table_ptr : Pointer; $formName_t : Text; $width_ptr : Pointer; $height_ptr : Pointer)

If (Is nil pointer($table_ptr))
	FORM GET PROPERTIES($formName_t; $width_ptr->; $height_ptr->)
Else 
	FORM GET PROPERTIES($table_ptr->; $formName_t; $width_ptr->; $height_ptr->)
End if 

