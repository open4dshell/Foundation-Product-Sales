// ----------------------------------------------------
// Project Method: Fnd_Host_GetIntegerValue ($variableName_t) --> Integer

// Allows a component to get the value of a host long integer variable.

// Access: Shared

// Parameters: 
//   $variableName_t : Text : The variable name

// Returns:
//   $value_i : Integer : The variable's value

// This method was automatically generated by Foundation on Oct 18, 2026.
// ----------------------------------------------------

#DECLARE($variableName_t : Text)->$value_i : Integer

var Fnd_Host_IntegerValue_t : Integer  // A process variable, so EXECUTE FORMULA can assign to it.

EXECUTE FORMULA("Fnd_Host_IntegerValue_t:="+$variableName_t)

$value_i:=Fnd_Host_IntegerValue_t

