//%attributes = {"invisible":false,"shared":true}
// ----------------------------------------------------
// Project Method: Fnd_Hook_Out_RowStyle --> Object

// Styles the rows of a Foundation output list. It is evaluated for every
//   row displayed, with This set to the row's entity. Return an object with
//   any of fontWeight, fontStyle, textDecoration, stroke and fill, as 4D's
//   Meta Info Expression describes; an empty object leaves the row as it is.
// A layout with its own row-style rules is used instead of this hook.

// Access: Shared

// Parameters: None

// Returns:
//   $style_o : Object : The row's style

// This method was automatically generated by Foundation on Oct 16, 2026.
// ----------------------------------------------------

#DECLARE()->$style_o : Object

$style_o:=New object

// Every property the row style may carry (4D's Meta Info Expression):
//   $style_o.stroke:="red"  // text colour: any CSS colour, "#C00000", "automatic", "transparent"
//   $style_o.fill:="#FFFFC0"  // background colour, same values
//   $style_o.fontWeight:="bold"  // "normal" or "bold"
//   $style_o.fontStyle:="italic"  // "normal" or "italic"
//   $style_o.textDecoration:="underline"  // "normal" or "underline"
//   $style_o.unselectable:=True  // the row cannot be selected
//   $style_o.disabled:=True  // the row is dimmed and cannot be entered
//   $style_o.cell:=New object("<column object name>"; New object("stroke"; "blue"))
//               // one column only: stroke, fill, fontStyle, fontWeight, textDecoration
// Font name and font size cannot be set per row; they belong to the list as a whole.

// EXAMPLE CODE: bold rows for invoices over 500.
//Case of 
//	: (Fnd_Gen_CurrentTable=(->[Invoices]))
//		If (This.Total>500)
//			$style_o.fontWeight:="bold"
//		End if 
//End case 

$style_o:=New object

// EXAMPLE CODE: bold rows for invoices over 500.
Case of 
	: (Fnd_Gen_CurrentTable=(->[Invoices]))
		If (This.Total>500)
			$style_o.fontWeight:="bold"
		End if 
		
	: (Fnd_Gen_CurrentTable=(->[Products]))
		If (This.ListPrice>500)
			$style_o.fontWeight:="bold"
			$style_o.stroke:="red"
		End if 
End case 
