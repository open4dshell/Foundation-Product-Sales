// Foundation asks this once per table when the shell starts (Fnd_Tbl_CreateAccessArray)
//   and keeps the answers. Fnd_Tbl_UserCanAccess returns them, and the Find Related
//   routines skip the tables the user may not see.
// Return False to hide a table from the current user.

// Access: Shared

// Parameters: 
//   $table_ptr : Pointer : The table in question

// Returns:
//   $canDisplay_b : Boolean : May the current user display this table?

// This method was automatically generated by Foundation on Nov 10, 2026.
// ----------------------------------------------------

#DECLARE($table_ptr : Pointer)->$canDisplay_b : Boolean

$canDisplay_b:=True  // Every table, for every user.

