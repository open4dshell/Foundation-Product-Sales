//%attributes = {"invisible":false,"shared":true}
// ----------------------------------------------------
// Project Method: Fnd_Hook_Out_ContextMenu ($table_ptr; $selected_es; $clicked_e; $row_i)

// Called when the user right-clicks (or Control-clicks on a Mac) a Foundation output
//   list. This method builds the pop-up menu, shows it and acts on the choice.
//   Without this method the list has no contextual menu.

// Access: Shared

// Parameters:
//   $table_ptr : Pointer : The list's table
//   $selected_es : Object : The highlighted records as an entity selection, empty when none
//   $clicked_e : Object : The entity under the pointer, Null over empty space below the rows
//   $row_i : Integer : The clicked row (1 to the number of rows), 0 over empty space

// Returns: Nothing

// This method was automatically generated by Foundation on Oct 21, 2026.
// ----------------------------------------------------

#DECLARE($table_ptr : Pointer; $selected_es : Object; $clicked_e : Object; $row_i : Integer)

var $menu_t : Text
var $choice_i : Integer
var $editLimit_i : Integer

// The most records Edit offers at once. Change it to suit.
$editLimit_i:=10

// A row that was not already highlighted has been highlighted alone before this method
//   is called; over empty space nothing is highlighted, so only New is offered.
// No classic record of the table is loaded while this method runs, so a record can be
//   saved through ORDA without a lock error. The list is redisplayed when this method returns.

// Item numbers: 1 New, 3 Edit Record(s), 5 Delete, 7 Show Subset, 8 Omit Subset.
//   Every separator is an item too.
$menu_t:=Fnd_Loc_GetString("Fnd_Menu"; "EnterNewRecord")

If ($selected_es.length>0)
	
	// Not localised: Fnd_Menu has no string for these labels. A disabled item still counts.
	Case of 
		: ($selected_es.length=1)
			$menu_t:=$menu_t+";(-;Edit Record"
			
		: ($selected_es.length<=$editLimit_i)
			$menu_t:=$menu_t+";(-;Edit Records"
			
		Else 
			$menu_t:=$menu_t+";(-;(Edit Records — more than "+String($editLimit_i)+" highlighted"
	End case 
	
	$menu_t:=$menu_t+";(-;"+Fnd_Loc_GetString("Fnd_Menu"; "EnterDeleteSubset")
	$menu_t:=$menu_t+";(-;"+Fnd_Loc_GetString("Fnd_Menu"; "SelectShowSubset")
	$menu_t:=$menu_t+";"+Fnd_Loc_GetString("Fnd_Menu"; "SelectOmitSubset")
	
	// EXAMPLE CODE: an item for one table only (item 9), handled below.
	//If ($table_ptr=(->[MyTable]))
	//	$menu_t:=$menu_t+";(-;Archive"
	//End if 
End if 

$choice_i:=Pop up menu($menu_t)

Case of 
	: ($choice_i=1)
		Fnd_Rec_NewRecord($table_ptr)
		
	: ($choice_i=3)
		If ($selected_es.length=1)
			Fnd_Out_EditRecord($row_i)
		Else 
			Fnd_Out_EditSelection($selected_es)
		End if 
		
	: ($choice_i=5)
		Fnd_Rec_DeleteUserSet
		
	: ($choice_i=7)
		Fnd_Rec_ShowSubset
		
	: ($choice_i=8)
		Fnd_Rec_OmitSubset
		
		// EXAMPLE CODE: the handler for the item added above, saving through ORDA.
		//: ($choice_i=9)
		//	For each ($entity_e; $selected_es)
		//		$entity_e.archived:=True
		//		$status_o:=$entity_e.save()
		//	End for each 
End case 
