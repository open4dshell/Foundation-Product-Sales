// ----------------------------------------------------
// Project Method: Fnd_Host_Tlbr_SetBtnPict ($buttonNumber_i; $buttonImage_pic)

// Allows a component to set a toolbar button image in the host's variable
//   space when compiled.

// Access: Shared

// Parameters: 
//   $buttonNumber_i : Integer : The button index
//   $buttonImage_pic : Picture : The button image

// Returns: Nothing

// This method was automatically generated by Foundation on Oct 18, 2026.
// ----------------------------------------------------

#DECLARE($buttonNumber_i : Integer; $buttonImage_pic : Picture)

var $button_ptr : Pointer

$button_ptr:=Get pointer("Fnd_Tlbr_ButtonImage"+String($buttonNumber_i)+"_pic")
$button_ptr->:=$buttonImage_pic

