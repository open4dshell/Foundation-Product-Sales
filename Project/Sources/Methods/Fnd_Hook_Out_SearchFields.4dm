//%attributes = {"invisible":false,"shared":true}
// ----------------------------------------------------
// Project Method: Fnd_Hook_Out_SearchFields ($table_ptr)

// Called each time a Foundation output list opens, to declare the fields its
//   search box looks in. Call Fnd_Out_AddSearchField once for each field. A
//   table with no declarations gets no search box.
// A field is given as a pointer, as a text path through relations
//   ("contact.LastName"), or as an object; the optional second parameter is the
//   operator: begins (the default), contains, keyword or exact.
// The optional third parameter is the title shown in the search box's hint and
//   tip; it defaults to the field's virtual field name. Fnd_Out_SearchHint
//   replaces the generated hint and tip for the table being opened.

// Access: Shared

// Parameters:
//   $table_ptr : Pointer : The list's table

// Returns: Nothing

// This method was automatically generated by Foundation on Nov 4, 2026.
// ----------------------------------------------------

#DECLARE($table_ptr : Pointer)

Case of 
	: ($table_ptr=(->[Contacts]))
		Fnd_Out_AddSearchField(->[Contacts]LastName; "contains")
		Fnd_Out_AddSearchField(->[Contacts]FirstName; "contains")
		Fnd_Out_AddSearchField(->[Contacts]Company; "contains")
		
	: ($table_ptr=(->[Invoices]))
		Fnd_Out_AddSearchField(->[Invoices]InvoiceNumber; ""; "Inv. #")
		Fnd_Out_AddSearchField(->[Invoices]InvoiceDate)
		Fnd_Out_AddSearchField("contact.LastName"; ""; "Customer")
		
	: ($table_ptr=(->[Products]))
		Fnd_Out_AddSearchField(->[Products]ProductNumber)
		Fnd_Out_AddSearchField(->[Products]ProductName; "keyword")
		Fnd_Out_SearchHint("Number or name"; "Product numbers match from the start; names match whole words."+Char(Carriage return)+"Searches: "+Fnd_Out_SearchHelp)
End case 


